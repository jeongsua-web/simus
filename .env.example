# Copy to .env.production on EC2. Never commit real values.
# Use a full SHA tag from Actions, or ghcr.io/jeongsua-web/simus@sha256:...
SIMUS_IMAGE=ghcr.io/jeongsua-web/simus:sha-REPLACE_WITH_FULL_COMMIT_SHA
SIMUS_BIND_ADDRESS=127.0.0.1
SIMUS_PORT=3000

# PostgreSQL 16 runs as service db on an internal Docker network; no host 5432.
# Generate TWO distinct values on EC2: openssl rand -hex 32 (run twice).
# The admin credential stays in db; web uses the restricted simus_app role.
# Keep SIMUS_DB_PASSWORD as exactly 64 hex characters for URL safety.
POSTGRES_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_ADMIN_PASSWORD
SIMUS_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# compose.prod.yaml constructs DATABASE_URL from SIMUS_DB_PASSWORD internally:
# postgresql://simus_app:<SIMUS_DB_PASSWORD>@db:5432/simus
# These bootstrap values apply only to a NEW empty volume. Editing this file
# later does not rotate existing DB passwords or reapply the initialization SQL.

ADMIN_TOKEN_ISSUER=https://REPLACE_WITH_AUTH_ISSUER
ADMIN_TOKEN_AUDIENCE=simus-admin
# Set exactly ONE of ADMIN_JWKS_URL and ADMIN_JWKS_JSON.
ADMIN_JWKS_URL=https://REPLACE_WITH_AUTH_ISSUER/.well-known/jwks.json
ADMIN_JWKS_JSON=
# Generate on the server with: openssl rand -hex 32
SESSION_JOB_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS

# Optional Web Push: configure all three together; private key stays server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
