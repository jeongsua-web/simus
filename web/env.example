# web 디렉터리에서 복사해 사용하세요: cp env.example .env.local
# 저장소 루트에서 docker compose up -d 실행 후 사용하는 로컬 개발 DB입니다.
# 배포 환경에서는 해당 환경의 PostgreSQL 연결 정보로 변경하세요.
DATABASE_URL=postgresql://simus:simus_dev_password@localhost:5432/simus

# 관리자 OIDC/JWT 검증. 로컬 JWKS JSON과 HTTPS JWKS URL 중 하나만 설정합니다.
ADMIN_TOKEN_ISSUER=https://identity.example.com/
ADMIN_TOKEN_AUDIENCE=simus-admin
ADMIN_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ADMIN_JWKS_JSON={"keys":[...]}

# 스케줄러가 /api/internal/sessions/reconcile에 보내는 32자 이상의 무작위 Bearer 값입니다.
SESSION_JOB_TOKEN=replace-with-at-least-32-random-characters
