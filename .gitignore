# IDE
.idea/
*.swp
*.swo

# 임시 파일
*.tmp
*.temp
*.log

# Archived prototype development caches and generated binaries.
# core.ignorecase treats Library and library as the same name, so the
# asset source tree has to be un-ignored explicitly.
**/Library/
!/assets/library/
!/assets/library/**
**/Temp/
**/Obj/
**/Logs/
**/UserSettings/
**/Builds/
**/__pycache__/
**/.venv/
*.pyc
*.tsbuildinfo

# Local administrator credentials
.secrets/
