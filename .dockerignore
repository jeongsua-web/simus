# Admit only the Next.js build inputs. Keep the Unity/Blender source tree,
# DB scripts, Git history, local credentials, and caches outside the context.
**
!web/
!web/package.json
!web/package-lock.json
!web/next.config.ts
!web/tsconfig.json
!web/eslint.config.mjs
!web/v003-webgl.lock.json
!web/scripts/
!web/scripts/verify-v003-webgl.mjs
!web/src/
!web/src/**
!web/public/
!web/public/**

# Exclude retired builds and older outputs from the v003 build directory.
web/public/city/
web/public/city-rebuild-v002*/
web/public/unity-preview/
web/public/unity/city-masterplan-v003-local-v1/Build/city-masterplan-v003-local-v1.*
web/public/.unity-preview-*/
web/public/.unity-artifact-*/
**/.env*
**/.DS_Store
**/*.pem
**/*.p12
**/*.pfx
**/*.key
